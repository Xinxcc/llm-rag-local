# Copy this file to ".env" and fill in real values. Do NOT commit ".env".

# API auth — required. Generate a strong random value, e.g. `openssl rand -hex 32`
API_KEY=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=gemma3:1b
EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=company_kb

# Retrieval / chunking
TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=120
